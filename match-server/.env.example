# 이 파일을 .env 로 복사해서 값 채우기.  .env 는 절대 깃허브에 올리지 말 것 (.gitignore 에 있음)
# SUPABASE_*, GEMINI_*, INTERNAL_KEY 는 김준희 서버(server/.env)와 같은 값

# Supabase > Project Settings > API Keys  (URL 은 .supabase.co 로 끝나야 함, /rest/v1 붙이지 않기)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Gemini (임베딩 + 상위 후보 재비교)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Firebase 서비스 계정 키 파일 (이 폴더에 두기, 깃허브 X)
FIREBASE_CREDENTIALS=firebase-service-account.json

# 김준희 서버가 /internal/match/... 를 부를 때 쓰는 비밀값 (server/.env 의 INTERNAL_KEY 와 같게)
INTERNAL_KEY=

# 수령 코드 만들 때 쓰는 비밀값 (아무 긴 문자열, 이 서버에만)
PICKUP_SECRET=

# 매칭 기준 (테스트하면서 조정)
NOTIFY_THRESHOLD=60
SEM_FLOOR=0.5
