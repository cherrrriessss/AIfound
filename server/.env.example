# 이 파일을 .env 로 복사해서 값 채우기.  .env 는 절대 깃허브에 올리지 말 것 (.gitignore 에 있음)
# 키 이름은 주희선 님 서버 .env 와 같음 → 값은 카톡으로 받은 그대로 붙여 넣기

# true  = 키 없이 혼자 테스트 (메모리 DB, 인증코드는 서버 창에 출력, AI 는 고정 결과)
# false = 실제 Supabase + Gemini + 매칭 서버 사용
MOCK=true
# true 로 하면 MOCK 의 AI 결과가 '학생증(개인정보 있음)'으로 나온다 → S11 가림 화면 시연용
MOCK_PII=false

# 학교 메일 도메인 (팀에서 최종 확인)
SCHOOL_EMAIL_DOMAIN=soongsil.ac.kr

# Supabase > Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# (선택) publishable/anon 키. 비우면 SERVICE 키로 인증코드를 보낸다
SUPABASE_ANON_KEY=
PHOTO_BUCKET=found-photos

# Gemini (주희선 님과 같은 키·모델)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 매칭 서버(주희선) — 저장 직후 /internal/match/... 호출
MATCH_API_URL=http://localhost:8000
INTERNAL_KEY=

# 건물 이름 목록 (13 건물 선택, 쉼표 구분). 비우면 lockers 표의 건물을 쓴다
CAMPUS_BUILDINGS=

# MOCK 모드 토큰 서명 키 (32자 이상 아무 문자열)
MOCK_JWT_SECRET=aifound-dev-secret-change-me-0123456789
