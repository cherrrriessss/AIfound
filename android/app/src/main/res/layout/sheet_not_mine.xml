<?xml version="1.0" encoding="utf-8"?>
<!-- S21 내 물건 아님 피드백 (와이어프레임 S21_NotMine) — 아래에서 올라오는 시트 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="어떤 점이 달랐나요?"
        android:textColor="@color/ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        style="@style/AIfound.Hint"
        android:layout_marginTop="4dp"
        android:text="알려주시면 다음 매칭이 더 정확해져요"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/cbCategory"
        style="@style/AIfound.Reason"
        android:layout_marginTop="16dp"
        android:text="종류가 달라요" />

    <CheckBox
        android:id="@+id/cbColor"
        style="@style/AIfound.Reason"
        android:text="색이 달라요" />

    <CheckBox
        android:id="@+id/cbBrand"
        style="@style/AIfound.Reason"
        android:text="브랜드·모델이 달라요" />

    <CheckBox
        android:id="@+id/cbPlace"
        style="@style/AIfound.Reason"
        android:text="장소·시간이 안 맞아요" />

    <CheckBox
        android:id="@+id/cbOther"
        style="@style/AIfound.Reason"
        android:text="기타" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/AIfound.OutlineButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="건너뛰기"
            android:textSize="14sp"
            app:strokeColor="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/AIfound.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.4"
            android:text="보내고 후보에서 제외"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
