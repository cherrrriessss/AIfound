<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/AIfound.Label" android:text="건물 *" />

            <Spinner
                android:id="@+id/spBuilding"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="8dp" />

            <TextView style="@style/AIfound.Label" android:layout_marginTop="20dp" android:text="상세 위치" />

            <EditText
                android:id="@+id/etPlace"
                style="@style/AIfound.Input"
                android:hint="예: 3층 302호 앞 복도 의자"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="100" />

            <TextView style="@style/AIfound.Label" android:layout_marginTop="20dp" android:text="주운 시간 *" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDate"
                    style="@style/AIfound.OutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    app:strokeColor="@color/line" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTime"
                    style="@style/AIfound.OutlineButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    app:strokeColor="@color/line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNow"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="방금"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHourAgo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1시간 전"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMorning"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="오늘 오전"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView style="@style/AIfound.Label" android:layout_marginTop="20dp" android:text="물건 특징 (선택)" />

            <EditText
                android:id="@+id/etDesc"
                style="@style/AIfound.Input"
                android:layout_height="96dp"
                android:gravity="top"
                android:hint="예: 케이스에 고양이 스티커가 붙어 있어요"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="300"
                android:paddingTop="12dp"
                android:textSize="14sp" />

            <TextView
                style="@style/AIfound.Hint"
                android:layout_marginTop="6dp"
                android:text="주인만 아는 특징(내용물 등)은 적지 마세요. 본인 확인에 쓰여요." />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/AIfound.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_margin="20dp"
        android:text="다음" />
</LinearLayout>
