<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_warn"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warn_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBannerBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/warn_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <com.aifound.app.ui.MaskEditorView
        android:id="@+id/maskEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_weight="1"
        android:background="@color/line_soft"
        android:contentDescription="개인정보 가림 편집 영역" />

    <TextView
        android:id="@+id/tvMaskHint"
        style="@style/AIfound.Hint"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="점선 = AI가 감지했지만 아직 안 가린 영역" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoMask"
            style="@style/AIfound.OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="자동 가림"
            android:textSize="13sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDraw"
            style="@style/AIfound.OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="직접 가리기"
            android:textSize="13sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUndo"
            style="@style/AIfound.OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="되돌리기"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/AIfound.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_margin="20dp"
        android:text="다음" />
</LinearLayout>
