<?xml version="1.0" encoding="utf-8"?>
<!-- S28 설정 (와이어프레임 S28_Settings) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/AIfound.Section"
                android:layout_marginTop="8dp"
                android:text="계정" />

            <TextView
                android:id="@+id/menuProfile"
                style="@style/AIfound.MenuRow"
                android:text="프로필 수정" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="학교 메일"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/ink_quiet"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/menuNoti"
                style="@style/AIfound.MenuRow"
                android:text="알림 설정" />

            <TextView
                style="@style/AIfound.Section"
                android:text="정보" />

            <TextView
                android:id="@+id/menuPrivacy"
                style="@style/AIfound.MenuRow"
                android:text="개인정보 처리방침" />

            <TextView
                android:id="@+id/menuTerms"
                style="@style/AIfound.MenuRow"
                android:text="이용약관" />

            <TextView
                android:id="@+id/menuServer"
                style="@style/AIfound.MenuRow"
                android:text="서버 주소" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="앱 버전"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_quiet"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/line_soft" />

            <TextView
                android:id="@+id/menuLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:text="로그아웃"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/menuDelete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:text="회원 탈퇴"
                android:textColor="#B42318"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
