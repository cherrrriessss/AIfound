<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="AIfound"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIfound"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ProfileActivity" android:windowSoftInputMode="adjustResize" />
        <!-- 이민서 파트: S06 홈, S07 찾아보기, S08 상세 -->
        <activity android:name=".ui.HomeActivity" android:launchMode="singleTop" />
        <activity android:name=".ui.FoundListActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".ui.FoundDetailActivity" />
        <!-- 김준희 파트 임시 홈(로그아웃·탈퇴·내 습득물). S22 마이페이지가 생기면 지운다 -->
        <activity android:name=".ui.TempMyPageActivity" />
        <activity android:name=".ui.PhotoActivity" />
        <activity android:name=".ui.MaskingActivity" />
        <activity android:name=".ui.AiTagsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.FoundInfoActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.StorageActivity" />
        <activity android:name=".ui.FoundDoneActivity" />

        <!-- 카메라 앱이 찍은 사진을 저장할 임시 파일 공유 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
