<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="AIfound"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIfound"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ProfileActivity" android:windowSoftInputMode="adjustResize" />
        <!-- 이민서 파트: S06 홈, S07 찾아보기, S08 상세 -->
        <activity android:name=".ui.HomeActivity" android:launchMode="singleTop" />
        <activity android:name=".ui.FoundListActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".ui.FoundDetailActivity" />
        <activity android:name=".ui.PhotoActivity" />
        <activity android:name=".ui.MaskingActivity" />
        <activity android:name=".ui.AiTagsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.FoundInfoActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.StorageActivity" />
        <activity android:name=".ui.FoundDoneActivity" />

        <!-- 이민서 파트: S04 온보딩, S09 보관함, S16~S21 분실 신고·매칭·수령, S22~S28 마이페이지 -->
        <activity android:name=".ui.OnboardingActivity" />
        <activity android:name=".ui.StorageMapActivity" />
        <activity android:name=".ui.LostReportActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LostDoneActivity" />
        <activity android:name=".ui.MatchListActivity" />
        <activity android:name=".ui.MatchDetailActivity" />
        <activity android:name=".ui.ClaimActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.MyPageActivity" />
        <activity android:name=".ui.MyLostActivity" />
        <activity android:name=".ui.MyFoundActivity" />
        <activity android:name=".ui.HistoryActivity" />
        <activity android:name=".ui.NotiSettingActivity" />
        <activity android:name=".ui.InboxActivity" />
        <activity android:name=".ui.SettingsActivity" />

        <!-- S05 푸시 (FCM). 앱이 꺼져 있을 때 시스템이 띄우는 알림의 아이콘·채널 -->
        <service android:name=".util.PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_bell" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aifound_alerts" />

        <!-- 카메라 앱이 찍은 사진을 저장할 임시 파일 공유 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
